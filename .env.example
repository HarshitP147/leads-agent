# --- LLM for extraction (pick one provider) ---
LLM_PROVIDER=anthropic            # anthropic | openai
EXTRACTION_MODEL=                 # e.g. a strong Claude or GPT model id
NAVIGATION_MODEL=                 # cheap/fast model for Browser Use fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search (bonus: LinkedIn lookup) ---
TAVILY_API_KEY=

# --- Runtime ---
MAX_CONCURRENT_DOMAINS=3
PAGE_TIMEOUT_S=25
MAX_PAGES_PER_DOMAIN=6
MAX_CHARS_PER_PAGE=12000
BROWSER_USE_ENABLED=true
BROWSER_USE_MAX_STEPS=8
HEADLESS=true
