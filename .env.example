# --- LLM for extraction (pick one provider) ---
LLM_PROVIDER=deepseek             # deepseek | anthropic | openai
EXTRACTION_MODEL=deepseek-flash  # DeepSeek model id — see docs/references/stack.md
NAVIGATION_MODEL=deepseek-flash                 # cheap/fast model for Browser Use fallback (bonus, M9)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=                # optional override; defaults to https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search (bonus: LinkedIn lookup) ---
TAVILY_API_KEY=

# --- Runtime ---
MAX_CONCURRENT_DOMAINS=3
PAGE_TIMEOUT_S=25
MAX_PAGES_PER_DOMAIN=6
MAX_CHARS_PER_PAGE=12000
BROWSER_USE_ENABLED=true
BROWSER_USE_MAX_STEPS=8
HEADLESS=true
